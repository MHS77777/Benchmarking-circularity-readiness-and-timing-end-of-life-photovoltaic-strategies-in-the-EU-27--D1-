UK": "United Kingdom"}}}, "time": {"label": "Time", "category": {"index": {"2005": 0, "2006": 1, "2007": 2, "2008": 3, "2009": 4, "2010": 5, "2011": 6, "2012": 7, "2013": 8, "2014": 9, "2015": 10, "2016": 11, "2017": 12, "2018": 13, "2019": 14, "2020": 15, "2021": 16, "2022": 17, "2023": 18}, "label": {"2005": "2005", "2006": "2006", "2007": "2007", "2008": "2008", "2009": "2009", "2010": "2010", "2011": "2011", "2012": "2012", "2013": "2013", "2014": "2014", "2015": "2015", "2016": "2016", "2017": "2017", "2018": "2018", "2019": "2019", "2020": "2020", "2021": "2021", "2022": "2022", "2023": "2023"}}}}, "extension": {"lang": "EN", "description": "<p>The indicator measures&nbsp;\u201cNumber of persons employed\u201d&nbsp;in the following three sectors: the recycling sector, repair and reuse sector and rental and leasing sector.</p><p>Jobs are expressed in number of persons employed and as a percentage of total employment. </p><p>Number of persons employed is defined as the total number of persons who work in the observation unit, i.e. the firm (inclusive of working proprietors, partners working regularly in the unit and unpaid family workers), as well as persons who work outside the unit who belong to it and are paid by it - e.g. sales representatives, delivery personnel, repair and maintenance teams. It excludes manpower supplied to the unit by other enterprises, persons carrying out repair and maintenance work in the enquiry unit on behalf of other enterprises, as well as those on compulsory military service.</p>", "id": "CEI_CIE011", "agencyId": "ESTAT", "version": "1.0", "datastructure": {"id": "CEI_CIE011", "agencyId": "ESTAT", "version": "6.0"}, "annotation": [{"type": "CREATED", "date": "2022-07-20T16:07:08+0200"}, {"type": "DISSEMINATION_DOI_XML", "title": "<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/CEI_CIE011\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/CEI_CIE011</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2024-02-06</dct:issued></adms:Identifier></adms:identifier>"}, {"type": "DISSEMINATION_OBJECT_TYPE", "title": "DATASET"}, {"type": "DISSEMINATION_TIMESTAMP_DATA", "date": "2025-08-06T15:49:00+0200"}, {"type": "DISSEMINATION_TIMESTAMP_GLOBAL", "date": "2025-08-06T15:49:00+0200"}, {"type": "DISSEMINATION_TIMESTAMP_PLANNED", "date": "2025-03-21T23:00:00+0100"}, {"type": "ESMS_HTML", "title": "Explanatory texts (metadata)", "href": "https://ec.europa.eu/eurostat/cache/metadata/en/cei_cie011_esmsip2.htm"}, {"type": "ESMS_SDMX", "title": "Explanatory texts (metadata)", "href": "https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/cei_cie011_esmsip2.sdmx.zip"}, {"type": "OBS_COUNT", "title": "1098"}, {"type": "OBS_PERIOD_OVERALL_LATEST", "title": "2023"}, {"type": "OBS_PERIOD_OVERALL_OLDEST", "title": "2005"}, {"type": "SOURCE_INSTITUTIONS", "text": "Eurostat"}, {"type": "UPDATE_DATA", "date": "2025-03-21T23:00:00+0100"}, {"type": "UPDATE_STRUCTURE", "date": "2025-08-06T23:00:00+0200"}], "positions-with-no-data": {"freq": [], "indic_env": [], "unit": [], "geo": [], "time": []}}}